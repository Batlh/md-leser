<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainer"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/search_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/suchen"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true" />

        <TextView
            android:id="@+id/search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <ImageButton
            android:id="@+id/search_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/vorheriger"
            android:src="@drawable/ic_up" />

        <ImageButton
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/naechster"
            android:src="@drawable/ic_down" />

        <ImageButton
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/schliessen"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/replace_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/replace_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ersetzen_durch"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/replace_one"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/ersetzen" />

        <Button
            android:id="@+id/replace_all"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/alle" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/opt_case"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gross_klein" />

            <CheckBox
                android:id="@+id/opt_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ganzes_wort" />

            <RadioGroup
                android:id="@+id/opt_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/mode_normal"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/mode_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modus_normal" />

                <RadioButton
                    android:id="@+id/mode_extended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modus_erweitert" />

                <RadioButton
                    android:id="@+id/mode_regex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modus_regex" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/opt_all_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alle_tabs" />

            <Button
                android:id="@+id/search_count_all"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/zaehlen" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
